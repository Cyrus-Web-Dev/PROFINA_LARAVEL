APP_NAME="PROFINA Marketing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Buka aplikasi lewat alamat INI PERSIS (127.0.0.1 dan localhost dianggap situs berbeda oleh browser).
APP_URL=http://marketing.localhost:8004
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (buat dulu database kosong di PostgreSQL: CREATE DATABASE profina_marketing;) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=profina_marketing
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# file = tidak butuh tabel database, lebih cepat & lebih sedikit yang bisa error
SESSION_DRIVER=file
SESSION_COOKIE=profina_marketing_session
SESSION_LIFETIME=120
# PENTING utk PRODUCTION (bukan localhost): set true kalau situs sudah pakai HTTPS,
# supaya cookie sesi TIDAK PERNAH dikirim lewat koneksi HTTP biasa (anti session hijacking).
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Email (tidak dipakai Marketing; login ditangani Portal) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@profina.local"
MAIL_FROM_NAME="PROFINA Marketing"

# --- Marketing ---
MKT_MAX_DISCOUNT_PCT=5
MKT_TAX_PCT=11
MKT_QUOTATION_VALID_DAYS=14
MKT_COMPANY_NAME="PT Contoh Produksi"
MKT_COMPANY_ADDRESS="Alamat perusahaan"
MKT_COMPANY_PHONE=
MKT_COMPANY_EMAIL=
MKT_COMPANY_BANK=

# --- PROFINA (diisi otomatis oleh: php artisan profina:provision di core) ---
PROFINA_MODULE=marketing
PROFINA_CORE_URL=http://core.localhost:8000
PROFINA_CORE_INTERNAL_URL=http://127.0.0.1:8000
PROFINA_SSO_SECRET=
PROFINA_REVALIDATE_SECONDS=60

VITE_APP_NAME="${APP_NAME}"

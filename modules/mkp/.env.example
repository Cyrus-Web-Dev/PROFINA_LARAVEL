APP_NAME="MKP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Buka aplikasi lewat alamat INI PERSIS (127.0.0.1 dan localhost dianggap situs berbeda oleh browser).
APP_URL=http://mkp.localhost:8001
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (buat dulu database kosong: mkp_db, collation utf8mb4_unicode_ci) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mkp_db
DB_USERNAME=root
DB_PASSWORD=

# file = tidak butuh tabel database, lebih cepat & lebih sedikit yang bisa error
SESSION_DRIVER=file
SESSION_COOKIE=profina_mkp_session
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Email sistem (kode OTP, reset password) lewat Gmail API ---
MAIL_MAILER=gmail_api
MAIL_FROM_ADDRESS="noreply@mkp.local"
MAIL_FROM_NAME="MKP - Manajemen Keuangan"

# CARA TERCEPAT: salin credentials.json + token.json dari proyek Inventaris ke
# storage/app/credentials/  (tidak perlu isi apa pun di bawah ini).
# Cara lain: isi tiga baris ini (lihat README > "Menyiapkan Gmail API").
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Bila muncul error SSL "cURL error 60" (Windows/XAMPP), isi path file cacert.pem:
GMAIL_CA_BUNDLE=
# Mode lokal: kalau Gmail belum siap, kode OTP dicatat di storage/logs/laravel.log (hanya APP_ENV=local)
GMAIL_LOCAL_LOG_FALLBACK=true

# --- Hash password: Argon2id (butuh PHP dengan dukungan Argon2; cek: php -r 'var_dump(defined("PASSWORD_ARGON2ID"));') ---
HASH_DRIVER=argon2id
HASH_ARGON_MEMORY=65536
HASH_ARGON_TIME=4
HASH_ARGON_THREADS=1
# Biarkan false selama masih ada user dengan hash bcrypt lama (cek: php artisan mkp:hash-status).
HASH_VERIFY=false

# --- Aplikasi ---
MKP_APPROVAL_THRESHOLD=50000000
MKP_DUE_REMINDER_DAYS=7
# Pendaftaran: open = siapa pun bisa daftar, tetapi akun baru MENUNGGU PERSETUJUAN Manager.
#              closed = pendaftaran ditutup. (Pendaftar pertama selalu jadi Manager.)
MKP_REGISTRATION=open

# Backup database (menu Backup Data): jumlah file yang disimpan
MKP_BACKUP_KEEP=10
# Opsional bila mysqldump / pg_dump tidak ditemukan otomatis, mis. C:\xampp\mysql\bin\mysqldump.exe
MKP_MYSQLDUMP_PATH=
MKP_PG_DUMP_PATH=

# Opsional: buat admin awal saat `php artisan migrate --seed` (tanpa perlu registrasi/OTP)
MKP_ADMIN_NAME="Administrator"
MKP_ADMIN_EMAIL=
MKP_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# ==== Integrasi PROCURA (Sistem Pengadaan) ====
# Buat klien API "Sistem Keuangan" di PROCURA (menu Integrasi API), lalu salin token & rahasia webhook ke sini.
PROCURA_URL=http://127.0.0.1:8000/api/v1
PROCURA_TOKEN=
PROCURA_WEBHOOK_SECRET=
PROCURA_TIMEOUT=10
# Keputusan setuju >= nilai ini wajib oleh pemegang hak "Setujui jurnal bernilai besar" (bawaan = MKP_APPROVAL_THRESHOLD)
# PROCURA_APPROVAL_THRESHOLD=50000000

# --- Integrasi PAYBRIDGE (Payroll & Budgeting) ---
# Dibuat di PAYBRIDGE > Integrasi API > klien tipe "Keuangan" (token & rahasia tampil sekali).
PAYROLL_URL=http://127.0.0.1:8003/api/v1
PAYROLL_TOKEN=
PAYROLL_WEBHOOK_SECRET=
PAYROLL_APPROVAL_THRESHOLD=50000000
# true = anggaran SDM aktif dari PAYBRIDGE otomatis ditulis ke modul Anggaran.
PAYROLL_AUTO_APPLY_BUDGET=true

# --- PROFINA (diisi otomatis oleh: php artisan profina:provision di core) ---
PROFINA_MODULE=mkp
PROFINA_CORE_URL=http://core.localhost:8000
PROFINA_CORE_INTERNAL_URL=http://127.0.0.1:8000
PROFINA_SSO_SECRET=
PROFINA_REVALIDATE_SECONDS=60

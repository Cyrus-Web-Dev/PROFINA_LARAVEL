APP_NAME="PROFINA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Buka aplikasi lewat alamat INI PERSIS (127.0.0.1 dan localhost dianggap situs berbeda oleh browser).
APP_URL=http://core.localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (buat dulu database kosong di PostgreSQL: CREATE DATABASE profina_core;) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=profina_core
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# file = tidak butuh tabel database, lebih cepat & lebih sedikit yang bisa error
SESSION_DRIVER=file
SESSION_COOKIE=profina_core_session
SESSION_LIFETIME=120
# PENTING utk PRODUCTION (bukan localhost): set true kalau situs sudah pakai HTTPS,
# supaya cookie sesi TIDAK PERNAH dikirim lewat koneksi HTTP biasa (anti session hijacking).
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Email sistem (kode OTP login, reset password, notifikasi cuti/payroll) lewat Gmail API ---
MAIL_MAILER=gmail_api
MAIL_FROM_ADDRESS="noreply@profina.local"
MAIL_FROM_NAME="PROFINA"

# CARA TERCEPAT: salin credentials.json + token.json dari proyek MKP/Inventaris yang sudah jalan
# ke storage/app/credentials/  (tidak perlu isi apa pun di bawah ini).
# Cara lain: isi tiga baris ini (lihat README > "Menyiapkan Gmail API").
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Bila muncul error SSL "cURL error 60" (Windows/XAMPP), isi path file cacert.pem:
GMAIL_CA_BUNDLE=
# Mode lokal: kalau Gmail belum siap, kode OTP dicatat di storage/logs/laravel.log (hanya APP_ENV=local)
GMAIL_LOCAL_LOG_FALLBACK=true

# --- PROFINA ---
# Kunci induk (dibuat otomatis oleh: php artisan profina:provision). JANGAN dibagikan ke modul.
PROFINA_MASTER_KEY=
# Alamat browser tiap modul (subdomain *.localhost = cookie sesi tiap aplikasi terpisah).
PROFINA_URL_SDM=http://sdm.localhost:8002
PROFINA_URL_MKP=http://mkp.localhost:8001
PROFINA_URL_PAYROLL=http://payroll.localhost:8003
PROFINA_URL_MARKETING=http://marketing.localhost:8004
# Alamat server-ke-server (Portal -> modul). Di production samakan dengan alamat di atas.
PROFINA_INTERNAL_URL_SDM=http://127.0.0.1:8002
PROFINA_INTERNAL_URL_MKP=http://127.0.0.1:8001
PROFINA_INTERNAL_URL_PAYROLL=http://127.0.0.1:8003
PROFINA_INTERNAL_URL_MARKETING=http://127.0.0.1:8004
PROFINA_CORE_INTERNAL_URL=http://127.0.0.1:8000
PROFINA_TOKEN_TTL=60
PROFINA_SSO_SESSION_HOURS=12
PROFINA_REGISTRATION_ENABLED=true
# Admin awal (dibuat oleh migrate --seed)
PROFINA_ADMIN_NAME="Administrator PROFINA"
PROFINA_ADMIN_EMAIL=
PROFINA_ADMIN_PASSWORD=
